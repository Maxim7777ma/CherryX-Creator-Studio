[Unit]
Description=CherryX web app (Uvicorn ASGI alternative)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=cherryx
Group=cherryx
WorkingDirectory=/srv/cherryx
EnvironmentFile=/srv/cherryx/.env
ExecStart=/srv/cherryx/.venv/bin/uvicorn studio_site.asgi:application --host 127.0.0.1 --port 8000 --proxy-headers
Restart=always
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=20
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
