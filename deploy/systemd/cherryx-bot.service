[Unit]
Description=CherryX Telegram bot
After=network.target cherryx-web.service
PartOf=cherryx-web.service

[Service]
Type=simple
User=cherryx
Group=cherryx
WorkingDirectory=/srv/cherryx
EnvironmentFile=/srv/cherryx/.env
ExecStart=/srv/cherryx/.venv/bin/python -m src.bot
Restart=always
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=20
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
