[Unit]
Description=CherryX background worker
After=network.target cherryx-web.service
PartOf=cherryx-web.service

[Service]
Type=simple
User=cherryx
Group=cherryx
WorkingDirectory=/srv/cherryx
EnvironmentFile=/srv/cherryx/.env
ExecStart=/srv/cherryx/.venv/bin/python manage.py run_worker
Restart=always
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=20
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
