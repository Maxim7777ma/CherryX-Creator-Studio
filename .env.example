SHORTS_FOCUS_MODE=face
FACE_DETECTION_ENABLED=true
YOUTUBE_BACKSTAGE_ENABLED=true
BACKSTAGE_SAMPLE_LIMIT=420
BACKSTAGE_MIN_GAP_SECONDS=90
SUBTITLE_MODEL=medium
SUBTITLE_LANGUAGE=
