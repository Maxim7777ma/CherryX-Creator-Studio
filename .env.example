YOUTUBE_MAX_DURATION_MINUTES=360
YOUTUBE_MAX_SHORTS=15
YOUTUBE_SHORT_SECONDS=45
YOUTUBE_DOWNLOAD_TIMEOUT_SECONDS=3600
